<!--
  Goalkeeper laboratory mode. It intentionally bypasses GameController.
  Starting this tree authorizes autonomous head and body motion as soon as
  localization succeeds. Use only with the robot upright and the area clear.
-->
<root BTCPP_format="4">
    <include path="./subtrees/subtree_cam_find_and_track_ball.xml" />
    <include path="./subtrees/subtree_goal_keeper_play.xml" />
    <include path="./subtrees/subtree_locate.xml" />
    <BehaviorTree ID="MainTree">
        <Sequence name="Goalkeeper laboratory without GameController">
            <CamScanField _while="!odom_calibrated" />
            <SubTree ID="Locate" _autoremap="true" _while="!odom_calibrated" />
            <GoToReadyPosition />
            <SubTree ID="GoalKeeperPlay" _autoremap="true" />
        </Sequence>
    </BehaviorTree>
</root>
