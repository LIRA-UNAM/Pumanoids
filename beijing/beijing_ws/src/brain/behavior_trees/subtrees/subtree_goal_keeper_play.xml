<root BTCPP_format="4" >
   <include path="./subtree_cam_find_and_track_ball.xml" />
   <include path="./subtree_find_ball.xml" />
   <include path="./subtree_locate.xml" />
   <BehaviorTree ID="GoalKeeperPlay">
      <ReactiveSequence >
         <SelfLocate mode="trust_direction" />
         <SubTree ID="Locate" _autoremap="true" _while="decision!='find'" />
         <ReactiveSequence _while="wait_for_opponent_kickoff" name="Wait for opponent kickoff">
            <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
            <SetVelocity />
         </ReactiveSequence>
         <ReactiveSequence _while="!wait_for_opponent_kickoff" name="Our kickoff or opponent has kicked off">
            <Sequence _while="ball_out">
               <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
               <GoBackInField />
               <SubTree ID="Locate" _autoremap="true" _while="decision!='find'" />
            </Sequence>
            <ReactiveSequence _while="!ball_out">
               <ReactiveSequence _while="wait_for_opponent_kickoff" name="Wait for opponent kickoff">
                  <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
                  <SetVelocity />
               </ReactiveSequence>
               <Sequence _while="!wait_for_opponent_kickoff" name="Normal play">
                  <!-- Reactive so an incoming shot can preempt chase/adjust/kick.
                       After the threat clears, GoalieDecide immediately returns
                       to chase/adjust/kick for the post-block clearance. -->
                  <ReactiveSequence _while="goalie_mode=='attack'">
                     <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
                     <GoalieDecide decision_out="{decision}" decision_in="{decision}" chase_threshold="1.0" />
                     <GoalkeeperBlockShot _while="decision == 'block_shot'" />
                     <GoToGoalBlockingPosition _while="decision=='find'" />
                     <GoToGoalBlockingPosition _while="decision == 'retreat'" />
                     <Chase   _while="decision == 'chase'"  vx_limit="1.5"  vy_limit="0.3"  vtheta_limit="1.0"  dist="0.4" safe_dist="0.6" />
                     <Adjust  _while="decision == 'adjust'" turn_threshold="0.2" range="0.3" vx_limit="0.3" vy_limit="0.2" vtheta_limit="1.0"  />
                     <Kick _while="decision == 'kick' &amp;&amp; goalie_kick_type == 'default'" />
                     <RLVisionKick _while="decision == 'kick' &amp;&amp; goalie_kick_type == 'visual'" />
                  </ReactiveSequence>
                  <ReactiveSequence _while="goalie_mode == 'guard'">
                     <SubTree ID="CamFindAndTrackBall" _autoremap="true" />
                     <GoalieDecide decision_out="{decision}" decision_in="{decision}" />
                     <GoToReadyPosition _while="!ball_location_known" />
                     <GoalkeeperBlockShot _while="ball_location_known &amp;&amp; decision == 'block_shot'" />
                     <GoToGoalBlockingPosition _while="ball_location_known &amp;&amp; decision != 'block_shot'" />
                  </ReactiveSequence>

               </Sequence>
            </ReactiveSequence>
         </ReactiveSequence>
      </ReactiveSequence>
   </BehaviorTree>
</root>
